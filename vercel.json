{
  "version": 2,
  "functions": {
    "server.js": {
      "runtime": "@vercel/node"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/server.js"
    },
    {
      "source": "/status",
      "destination": "/server.js"
    },
    {
      "source": "/((?!api|status).*)",
      "destination": "/index.html"
    }
  ]
}
